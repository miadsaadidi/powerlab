#!/bin/sh
# Prevent pushing local merge commits directly to origin/main

while read local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        # Check if local main contains a local merge that wasn't generated by GitHub
        if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
            LOCAL_MERGES=$(git log ${remote_sha}..${local_sha} --merges --grep="Merge pull request" --invert-grep -n 1 --oneline)
            if [ -n "$LOCAL_MERGES" ]; then
                echo ""
                echo "================================================================================"
                echo "❌ ERROR: PUSH BLOCKED — LOCAL MERGE COMMIT DETECTED ON 'main'!"
                echo "--------------------------------------------------------------------------------"
                echo "Offending commit: $LOCAL_MERGES"
                echo ""
                echo "Local merge commits must not be pushed directly to origin/main."
                echo "All merges must occur via GitHub Pull Requests to trigger Vercel webhooks"
                echo "and maintain a verifiable PR history on GitHub."
                echo "================================================================================"
                echo ""
                exit 1
            fi
        fi
    fi
done

exit 0
